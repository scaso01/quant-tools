#!/bin/bash
#
# Pre-commit hook: Validate Python files before commit
# Catches syntax errors, undefined names, and secrets
#

echo "Running pre-commit checks..."

# Check for accidentally staged secrets
echo "Scanning for secrets..."
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)
if [ -n "$STAGED_FILES" ]; then
    SECRET_PATTERNS='(pplx-[a-zA-Z0-9]{20,}|AIzaSy[a-zA-Z0-9_-]{33}|-----BEGIN (RSA |EC |DSA |OPENSSH )?PRIVATE KEY-----|sk-[a-zA-Z0-9]{20,}|ghp_[a-zA-Z0-9]{36}|gho_[a-zA-Z0-9]{36}|FRED_API_KEY=[a-zA-Z0-9]{20,})'

    for file in $STAGED_FILES; do
        if [ -f "$file" ]; then
            if [[ "$file" == *.env.example ]]; then
                continue
            fi
            MATCHES=$(grep -En "$SECRET_PATTERNS" "$file" 2>/dev/null || true)
            if [ -n "$MATCHES" ]; then
                echo ""
                echo "=========================================="
                echo "POTENTIAL SECRET DETECTED"
                echo "=========================================="
                echo "File: $file"
                echo "$MATCHES"
                echo ""
                echo "If this is a false positive, use --no-verify to bypass."
                exit 1
            fi
        fi
    done
    echo "No secrets found in staged files."
fi

# Get list of staged Python files
STAGED_PY_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.py$')

if [ -z "$STAGED_PY_FILES" ]; then
    echo "No Python files staged, skipping checks."
    exit 0
fi

FAILED=0

# Check 1: Syntax validation
echo "Checking Python syntax..."
for file in $STAGED_PY_FILES; do
    if [ -f "$file" ]; then
        python -m py_compile "$file" 2>&1
        if [ $? -ne 0 ]; then
            echo "SYNTAX ERROR in $file"
            FAILED=1
        fi
    fi
done

# Check 2: Undefined names with pyflakes
if command -v pyflakes &> /dev/null; then
    echo "Running pyflakes..."
    for file in $STAGED_PY_FILES; do
        if [ -f "$file" ]; then
            OUTPUT=$(pyflakes "$file" 2>&1)
            if [ -n "$OUTPUT" ]; then
                echo "$OUTPUT"
                if echo "$OUTPUT" | grep -q "undefined name"; then
                    FAILED=1
                fi
            fi
        fi
    done
else
    echo "pyflakes not installed, skipping undefined name checks"
    echo "Install with: pip install pyflakes"
fi

if [ $FAILED -ne 0 ]; then
    echo ""
    echo "Pre-commit checks FAILED. Fix the errors above before committing."
    exit 1
fi

echo "Pre-commit checks passed."
exit 0
