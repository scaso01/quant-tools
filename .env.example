# FRED API key (free at https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=your_fred_api_key_here

# Finnhub API key (free at https://finnhub.io/)
FINNHUB_API_KEY=

# SEC EDGAR (email required by SEC fair-use policy)
SEC_EDGAR_EMAIL=your_email@example.com

# Reddit API (free at https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Local LLM for the AI Analysis page. Any OpenAI-compatible server works:
# llama.cpp, Ollama (http://localhost:11434/v1), vLLM. Leave unset and the page
# says so instead of failing; every other page is unaffected.
LLM_BASE_URL=http://localhost:8080
LLM_MODEL=
LLM_TIMEOUT=60

# Cache settings
# CACHE_DB_PATH is optional. Left unset, the cache goes in a per-user data
# directory (%LOCALAPPDATA%\quant-tools on Windows, ~/.local/share/quant-tools
# on Linux, ~/Library/Application Support/quant-tools on macOS) so it is shared
# no matter which directory you run from. Set it to an absolute path to move it.
# CACHE_DB_PATH=/path/to/quant_tools_cache.db
CACHE_TTL_HOURS=24

# Scanner settings
SCANNER_MAX_WORKERS=8
SCANNER_TOP_N=20

# Backtest defaults
BACKTEST_START_DATE=2020-01-01
BACKTEST_INITIAL_CAPITAL=100000

# Monte Carlo
MONTE_CARLO_SIMULATIONS=1000

# Logging
LOG_LEVEL=INFO
# Same as CACHE_DB_PATH: unset means the per-user data directory. A relative
# path here resolves against whatever directory you launch from, which fails
# outright if that directory is not writable.
# LOG_FILE=/path/to/quant_tools.log
