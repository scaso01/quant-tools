# FRED API key (free at https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=your_fred_api_key_here

# Finnhub API key (free at https://finnhub.io/)
FINNHUB_API_KEY=

# SEC EDGAR (email required by SEC fair-use policy)
SEC_EDGAR_EMAIL=your_email@example.com

# Reddit API (free at https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Cache settings
CACHE_DB_PATH=quant_tools_cache.db
CACHE_TTL_HOURS=24

# Scanner settings
SCANNER_MAX_WORKERS=8
SCANNER_TOP_N=20

# Backtest defaults
BACKTEST_START_DATE=2020-01-01
BACKTEST_INITIAL_CAPITAL=100000

# Monte Carlo
MONTE_CARLO_SIMULATIONS=1000

# Logging
LOG_LEVEL=INFO
LOG_FILE=quant_tools.log
